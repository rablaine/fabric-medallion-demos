/// Promotion / campaign master.
table dim_promotion
	lineageTag: aa000024-0000-0000-0000-000000000001

	column 'Promotion ID'
		dataType: int64
		formatString: '0'
		summarizeBy: none
		sourceColumn: promotion_id
		lineageTag: aa000024-0000-0000-0000-000000000002
		isKey

	column 'Promo Code'
		dataType: string
		summarizeBy: none
		sourceColumn: promo_code
		lineageTag: aa000024-0000-0000-0000-000000000003

	column 'Promo Name'
		dataType: string
		summarizeBy: none
		sourceColumn: promo_name
		lineageTag: aa000024-0000-0000-0000-000000000004

	column 'Discount Type'
		dataType: string
		summarizeBy: none
		sourceColumn: discount_type
		lineageTag: aa000024-0000-0000-0000-000000000005

	column 'Discount Value'
		dataType: decimal
		formatString: '0.00'
		summarizeBy: none
		sourceColumn: discount_value
		lineageTag: aa000024-0000-0000-0000-000000000006

	column 'Min Order Amount'
		dataType: decimal
		formatString: '\$#,0.00'
		summarizeBy: none
		sourceColumn: min_order_amount
		lineageTag: aa000024-0000-0000-0000-000000000007

	column 'Starts At'
		dataType: dateTime
		formatString: 'General Date'
		summarizeBy: none
		sourceColumn: starts_at
		lineageTag: aa000024-0000-0000-0000-000000000008
		displayFolder: Window

	column 'Ends At'
		dataType: dateTime
		formatString: 'General Date'
		summarizeBy: none
		sourceColumn: ends_at
		lineageTag: aa000024-0000-0000-0000-000000000009
		displayFolder: Window

	column 'Usage Limit'
		dataType: int64
		formatString: '#,0'
		summarizeBy: none
		sourceColumn: usage_limit
		lineageTag: aa000024-0000-0000-0000-00000000000a
		displayFolder: Usage

	column 'Times Used'
		dataType: int64
		formatString: '#,0'
		summarizeBy: sum
		sourceColumn: times_used
		lineageTag: aa000024-0000-0000-0000-00000000000b
		displayFolder: Usage

	column 'Is Active'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: is_active
		lineageTag: aa000024-0000-0000-0000-00000000000c
		displayFolder: Usage

	partition dim_promotion = entity
		mode: directLake
		source
			entityName: dim_promotion
			schemaName: dbo
			expressionSource: DatabaseQuery

	annotation PBI_ResultType = Table


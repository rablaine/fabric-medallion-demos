/// Calendar date dimension. Marked as date table on Date column.
table dim_date
	lineageTag: aa000020-0000-0000-0000-000000000001
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key
		lineageTag: aa000020-0000-0000-0000-000000000002

	column Date
		dataType: dateTime
		isKey
		formatString: 'Short Date'
		summarizeBy: none
		sourceColumn: date
		lineageTag: aa000020-0000-0000-0000-000000000003
		dataCategory: PaddedDateTableDates

	column Year
		dataType: int64
		formatString: '0'
		summarizeBy: none
		sourceColumn: year
		lineageTag: aa000020-0000-0000-0000-000000000004
		displayFolder: Calendar

	column Month
		dataType: int64
		formatString: '0'
		summarizeBy: none
		sourceColumn: month
		lineageTag: aa000020-0000-0000-0000-000000000005
		displayFolder: Calendar

	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		lineageTag: aa000020-0000-0000-0000-000000000006
		displayFolder: Calendar
		sortByColumn: Month

	column Quarter
		dataType: int64
		formatString: '0'
		summarizeBy: none
		sourceColumn: calendar_quarter
		lineageTag: aa000020-0000-0000-0000-000000000007
		displayFolder: Calendar

	column 'Day Name'
		dataType: string
		summarizeBy: none
		sourceColumn: day_name
		lineageTag: aa000020-0000-0000-0000-000000000008
		displayFolder: Calendar
		sortByColumn: 'Day of Week'

	column 'Day of Week'
		dataType: int64
		formatString: '0'
		summarizeBy: none
		sourceColumn: day_of_week
		lineageTag: aa000020-0000-0000-0000-000000000009
		displayFolder: Calendar

	column 'Is Weekend'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: is_weekend
		lineageTag: aa000020-0000-0000-0000-00000000000a
		displayFolder: Calendar

	column 'ISO Week'
		dataType: int64
		formatString: '0'
		summarizeBy: none
		sourceColumn: iso_week
		lineageTag: aa000020-0000-0000-0000-00000000000b
		displayFolder: Calendar

	column 'Fiscal Year'
		dataType: int64
		formatString: '0'
		summarizeBy: none
		sourceColumn: fiscal_year
		lineageTag: aa000020-0000-0000-0000-00000000000c
		displayFolder: Fiscal

	column 'Fiscal Quarter'
		dataType: int64
		formatString: '0'
		summarizeBy: none
		sourceColumn: fiscal_quarter
		lineageTag: aa000020-0000-0000-0000-00000000000d
		displayFolder: Fiscal

	column 'Fiscal Period'
		dataType: string
		summarizeBy: none
		sourceColumn: fiscal_period
		lineageTag: aa000020-0000-0000-0000-00000000000e
		displayFolder: Fiscal

	partition dim_date = entity
		mode: directLake
		source
			entityName: dim_date
			schemaName: dbo
			expressionSource: DatabaseQuery

	annotation PBI_ResultType = Table


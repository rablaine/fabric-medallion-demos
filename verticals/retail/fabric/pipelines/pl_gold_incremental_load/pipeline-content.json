{
  "properties": {
    "description": "Gold incremental load. Identical to pl_gold_initial_load (every sproc is DROP+CTAS so it is idempotent). Kept as a separate pipeline so callers can wire it into a different incremental orchestrator without changing the initial-load definition.",
    "activities": [
      {
        "name": "Refresh silver_mirror metadata",
        "description": "Refreshes the silver_mirror SQL analytics endpoint so the gold sprocs see current schema and data. Required because Fabric SEPs do NOT auto-discover OneLake shortcut tables or schema changes from overwriteSchema=True silver writes.",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "__REFRESH_SEP_NOTEBOOK_ID__",
          "workspaceId": "__GOLD_WORKSPACE_ID__"
        }
      },
      {
        "name": "Recreate dim_date",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [
          {
            "activity": "Refresh silver_mirror metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "storedProcedureName": "[dbo].[sp_RecreateDimDate]",
          "database": "contoso_retail_gold"
        },

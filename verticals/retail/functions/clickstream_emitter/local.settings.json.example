# Local development settings only -- NOT deployed to Azure.
# Copy to local.settings.json and fill in real values for `func start`.
{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "EVENTHUB_CONNECTION_STRING": "<Fabric Eventstream CustomEndpoint source primary connection string>",
    "TIMER_SCHEDULE": "*/30 * * * * *",
    "EVENTS_PER_FIRE": "50"
  }
}
